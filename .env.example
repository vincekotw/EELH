# ═══════════════════════════════════════════════════════════════
#  EELH — Variables de entorno
# ═══════════════════════════════════════════════════════════════
#  Copia este archivo como .env y rellena los valores reales.
#  NUNCA subas el .env real a GitHub.
# ═══════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────
# En producción, DEBUG debe ser False
DEBUG=True

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=pon-aqui-tu-clave-secreta

# Hosts permitidos (separados por coma, sin espacios)
# Local:   localhost,127.0.0.1,0.0.0.0
# Render:  tu-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Orígenes de confianza para CSRF (separados por coma)
# Local:   http://localhost:8000,http://127.0.0.1:8000
# Render:  https://tu-app.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Base de datos ─────────────────────────────────────────────
# Si está vacío, Django usa SQLite local.
# En producción (Render), poner la URL de Neon CON "-pooler".
# Para migraciones, usar la URL de Neon SIN "-pooler".
#
# Ejemplo:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Scheduler interno ─────────────────────────────────────────
# En desarrollo: True (APScheduler corre cada 5 min).
# En producción: False (el cron externo lo reemplaza).
ENABLE_SCHEDULER=True

# Intervalo en minutos para el scheduler local
SCHEDULER_INTERVALO_MINUTOS=5

# ── Cron externo ──────────────────────────────────────────────
# Token para el endpoint /api/cron/tick/.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_TOKEN=pon-aqui-tu-token-de-cron

# ── Web Push (opcional) ───────────────────────────────────────
# Genera las claves con:
#   python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print('PUB:', v.public_key_urlsafe_base64()); print('PRIV:', v.private_key_urlsafe_base64())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com